generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id        String   @id @default(cuid())
  correo    String   @unique
  password  String
  rol       String
  nombre    String
  documento String   @unique
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  estudiante Estudiante?
  docente    Docente?

  @@map("usuarios")
}

model Estudiante {
  id         String @id @default(cuid())
  usuarioId  String @unique
  documento  String @unique
  codigo     String @unique
  sede       String
  jornada    String
  grado      Int
  curso      String
  mesa       Int?

  usuario        Usuario              @relation(fields: [usuarioId], references: [id])
  calificaciones Calificacion[]
  consultas      ConsultaEstudiante[]
  informes       Informe[]

  @@index([curso])
  @@index([sede])
  @@map("estudiantes")
}

model Docente {
  id        String @id @default(cuid())
  usuarioId String @unique

  usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  asignaciones   DocenteMateria[]
  calificaciones Calificacion[]
  directores     DirectorGrupo[]

  @@map("docentes")
}

model Materia {
  id     String @id @default(cuid())
  nombre String
  grado  Int

  asignaciones   DocenteMateria[]
  calificaciones Calificacion[]

  @@map("materias")
}

model DocenteMateria {
  id        String @id @default(cuid())
  docenteId String
  materiaId String
  curso     String

  docente Docente @relation(fields: [docenteId], references: [id])
  materia Materia @relation(fields: [materiaId], references: [id])

  @@unique([docenteId, materiaId, curso])
  @@map("docente_materias")
}

model NotaItem {
  id             String   @id @default(cuid())
  calificacionId String
  tipo           String
  valor          Float
  descripcion    String?
  creadoEn       DateTime @default(now())

  calificacion Calificacion @relation(fields: [calificacionId], references: [id], onDelete: Cascade)

  @@map("notas_items")
}

model Calificacion {
  id           String   @id @default(cuid())
  estudianteId String
  materiaId    String
  docenteId    String
  periodo      Int
  anio         Int

  definitiva Float?

  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  materia    Materia    @relation(fields: [materiaId], references: [id])
  docente    Docente    @relation(fields: [docenteId], references: [id])
  notasItems NotaItem[]

  @@unique([estudianteId, materiaId, periodo, anio])
  @@map("calificaciones")
}

model ConsultaEstudiante {
  id           String @id @default(cuid())
  estudianteId String
  periodo      Int
  anio         Int
  cantidad     Int    @default(0)

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])

  @@unique([estudianteId, periodo, anio])
  @@map("consultas_estudiantes")
}

model Informe {
  id           String   @id @default(cuid())
  estudianteId String
  periodo      Int
  anio         Int
  rutaPdf      String
  generadoEn   DateTime @default(now())
  disponible   Boolean  @default(false)

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])

  @@unique([estudianteId, periodo, anio])
  @@map("informes")
}

// ─── Modelos añadidos en la migración 2 ───
// Sus tablas se crearon en desarrollo y se formalizaron en
// prisma/migrations/20260928120000_tablas_adicionales_e_indices/.
// FKs reales que solo existen en el SQL: observaciones estudianteId → estudiantes,
// password_resets usuarioId → usuarios, intentos_login documento → usuarios.documento.

model Observacion {
  id           String  @id @default(cuid())
  estudianteId String
  docenteId    String?
  materiaId    String
  texto        String
  tipo         String  @default("GENERAL")
  fecha        String?
  creadoEn     DateTime @default(now())

  @@index([estudianteId])
  @@index([materiaId])
  @@map("observaciones")
}

model PeriodoConfig {
  id               String   @id
  sede             String
  periodo          Int
  nombre           String   @default("Período 1")
  peso             Float    @default(0.25)
  fechaInicio      String?  @map("fecha_inicio")
  fechaFin         String?  @map("fecha_fin")
  fechaCorte       String?  @map("fecha_corte")
  abierto          Boolean  @default(true)
  anio             Int      @default(2025)
  reaperturaManual Int      @default(0) @map("reapertura_manual")

  @@unique([sede, periodo, anio])
  @@map("periodos_config")
}

model PasswordReset {
  id        String   @id @default(cuid())
  usuarioId String
  codigo    String
  expira    String
  usado     Int      @default(0)
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
  @@map("password_resets")
}

model DirectorGrupo {
  id        String   @id @default(cuid())
  docenteId String
  curso     String
  creadoEn  DateTime @default(now())

  docente Docente @relation(fields: [docenteId], references: [id])

  @@unique([docenteId, curso])
  @@index([curso])
  @@map("directores_grupo")
}

model Columna {
  id        String   @id @default(cuid())
  curso     String
  materiaId String
  periodo   Int
  anio      Int
  tipo      String
  titulo    String
  creadoEn  DateTime @default(now())

  @@unique([curso, materiaId, periodo, anio, tipo, titulo])
  @@map("columnas")
}

model IntentoLogin {
  documento      String  @id
  intentos       Int     @default(0)
  bloqueadoHasta String?

  @@map("intentos_login")
}