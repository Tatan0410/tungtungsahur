# ─── Base de datos ───
# SQLite en desarrollo. En producción (Supabase) usa la cadena de Postgres
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar los JWT. Obligatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia_esto_por_una_clave_segura"

# Puerto del servidor (en Vercel no aplica)
PORT=3000

# ─── CORS ───
# Lista separada por comas de orígenes permitidos.
# VACÍO = fail-closed: no se emite el header CORS (solo peticiones de mismo
# origen funcionan; la app se sirve a sí misma, así que esto es lo seguro).
# Si consumes la API desde otro dominio, defínelo aquí explícitamente.
ALLOWED_ORIGINS="https://tudominio.com"

# ─── Proxy inverso ───
# Ponlo en "1" solo si el servidor corre detrás de un proxy real (Vercel,
# Nginx, Cloudflare). Habilita que req.ip use X-Forwarded-For y los rate
# limits por IP funcionen. En Vercel: variable de entorno TRUST_PROXY=1.
# Si migras a VPS propio con nginx/Cloudflare delante, revisa el número
# de saltos del proxy.
TRUST_PROXY=1

# ─── Correo (recuperación de contraseña) ───
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="contraseña_de_aplicacion_de_gmail"
# El remitente ("from") se arma automáticamente a partir de SMTP_USER
