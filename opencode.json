{
  "$schema": "https://opencode.ai/config.json",
  "shell": "cmd.exe",
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "systematic-debugging", "effect": "allow" },
    { "action": "skill", "resource": "test-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "testing-webapps", "effect": "allow" },
    { "action": "skill", "resource": "reviewing-security", "effect": "allow" },
    { "action": "skill", "resource": "designing-frontend-interfaces", "effect": "allow" },
    { "action": "skill", "resource": "designing-user-experience", "effect": "allow" },
    { "action": "skill", "resource": "building-accessible-interfaces", "effect": "allow" },
    { "action": "skill", "resource": "reviewing-interface-quality", "effect": "allow" },
    { "action": "skill", "resource": "investigating-performance", "effect": "allow" },
    { "action": "skill", "resource": "evolving-apis-and-schemas", "effect": "allow" },
    { "action": "skill", "resource": "opencode", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "prisma/dev.db*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "prisma/dev.db*", "effect": "deny" },
    { "action": "edit", "resource": "respaldo-*.json", "effect": "deny" },
    { "action": "edit", "resource": "notas_backup.json", "effect": "deny" },
    { "action": "edit", "resource": "backups/*", "effect": "deny" },
    { "action": "edit", "resource": "*.xlsx", "effect": "deny" },
    { "action": "edit", "resource": "*.xls", "effect": "deny" },
    { "action": "edit", "resource": "*.csv", "effect": "deny" },
    { "action": "read", "resource": "*.xlsx", "effect": "deny" },
    { "action": "read", "resource": "*.xls", "effect": "deny" },
    { "action": "read", "resource": "*.csv", "effect": "deny" },
    { "action": "read", "resource": "respaldo-*.json", "effect": "ask" },
    { "action": "read", "resource": "notas_backup.json", "effect": "ask" },
    { "action": "read", "resource": "backups/*", "effect": "ask" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "cmd /c npm test", "effect": "allow" },
    { "action": "shell", "resource": "node --test *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/respaldar.js *", "effect": "allow" },
    { "action": "shell", "resource": "node admin.js *", "effect": "ask" },
    { "action": "shell", "resource": "node scripts/restaurar.js *", "effect": "ask" },
    { "action": "shell", "resource": "node volcar-a-postgres.js *", "effect": "ask" },
    { "action": "shell", "resource": "npm start", "effect": "ask" },
    { "action": "shell", "resource": "npm run dev", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ]
}
